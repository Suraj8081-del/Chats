<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All chats</title>
    <link rel="stylesheet" href ="style.css"/>
</head>
<body>
    <h2> All Chats</h2>
    <form method = "GET" action = "/chats/new">
        <button>New Chat</button>
    </form>
    <% for (let Chat of Chats) { %>
    <div class = "Chat">
        <p>from : <i><%= Chat.from %></i></p>
        <div class = "message">
            <p><%= Chat.message %></p>

            <form method = "GET" action = "/chats/<%= Chat._id %>/edit">
                <button>Edit</button>
            </form>
        </div> 
        <p>Received by :<i><%= Chat.to %></i></p>
       
        <p><%= Chat.created_at.toString().split(" ")[4] %></p>
         <p><%= Chat.created_at.toString().split(" ").slice(0,4).join("-") %></p><br/>
         <hr/>
    </div>
<% } %>
</body>
</html>